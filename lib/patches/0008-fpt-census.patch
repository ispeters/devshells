From: Ian Petersen <ispeters@gmail.com>
Subject: [PATCH] DIAGNOSTIC: census FunctionProtoType lookups, builds and provisional keys

NOT FOR UPSTREAM.  Instrumentation for llvm/llvm-project#191361.

Logs computed-noexcept FunctionProtoType lookups and constructions, and
whether the FoldingSetNodeID was computed while an
ImplicitConceptSpecializationDecl's trailing arguments were still unwritten
(PROVISIONAL-KEY).

This version is sized for running over a whole build and grepping:

  CLANG_FPT_CENSUS=1  quiet -- only provisional lookups/builds, [fpt-bad-*],
                      canonical-only [fpt-dup], one "tu=" line per TU, and
                      the summary.
  CLANG_FPT_CENSUS=2  verbose -- every computed-noexcept lookup and build,
                      as before.

The summary now breaks provisional keys down by exception-spec kind.
provisional-est6= is the number to look for: EST_DependentNoexcept is the only
kind whose noexcept expression survives into the canonical type's key, so it
is the only kind for which a provisional key can produce two canonical types
for one function type.  For EST_NoexceptTrue/False (est=8/7) the canonical
form is EST_BasicNoexcept/EST_None with no expression profiled, and a bad key
can only affect a sugar node.  A new [fpt-bad-dependent] line fires on any
est=6 provisional lookup so it is greppable without reading the summary.

Every line carries depth= from an RAII frame at getFunctionTypeInternal entry,
so the recursive OnlyWantCanonical call is visibly nested.  Built lines carry
est=, is-canonical= and canonical-null=.  [fpt-dup] fires only when more than
one node in a shallow-key group is its own canonical form.

Gated on CLANG_FPT_CENSUS.  CLANG_FPT_CENSUS_NAMES additionally prints type
spellings and the named concept; those run the TypePrinter and dereference a
ConceptDecl from inside the deserialization window, so they are off by default.

NOTE: paths in this diff are relative to the `clang/` subdirectory of the
llvm-project monorepo, to match this repo's clang derivation's sourceRoot.
Applies on top of 0003-0007; noteUnpopulatedRead() is introduced by 0005.
---
 lib/AST/ASTContext.cpp   | 235 ++++++++++++++++++++++++++++++++++++++-
 lib/AST/DeclTemplate.cpp |  12 ++
 2 files changed, 245 insertions(+), 2 deletions(-)

diff --git a/lib/AST/ASTContext.cpp b/lib/AST/ASTContext.cpp
index 2228811..32baf16 100644
--- a/lib/AST/ASTContext.cpp
+++ b/lib/AST/ASTContext.cpp
@@ -33,6 +33,7 @@
 #include "clang/AST/DependenceFlags.h"
 #include "clang/AST/Expr.h"
 #include "clang/AST/ExprCXX.h"
+#include "clang/AST/ExprConcepts.h"
 #include "clang/AST/ExternalASTSource.h"
 #include "clang/AST/Mangle.h"
 #include "clang/AST/MangleNumberingContext.h"
@@ -72,6 +73,7 @@
 #include "llvm/ADT/APSInt.h"
 #include "llvm/ADT/ArrayRef.h"
 #include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/StringMap.h"
 #include "llvm/ADT/DenseSet.h"
 #include "llvm/ADT/FoldingSet.h"
 #include "llvm/ADT/PointerUnion.h"
@@ -5049,6 +5051,219 @@ static bool isCanonicalExceptionSpecification(
   return false;
 }
 
+//===----------------------------------------------------------------------===//
+// CLANG_FPT_CENSUS: instrumentation for llvm/llvm-project#191361.
+//
+// Logs computed-noexcept FunctionProtoType lookups and constructions, and
+// whether the FoldingSetNodeID was computed while an
+// ImplicitConceptSpecializationDecl's trailing arguments were still unwritten
+// (PROVISIONAL-KEY).
+//
+//   CLANG_FPT_CENSUS=1   quiet: provisional lookups/builds, [fpt-bad-*],
+//                        canonical-only [fpt-dup], one tu= line, and the
+//                        summary.  Sized for grepping a whole build.
+//   CLANG_FPT_CENSUS=2   verbose: every computed-noexcept lookup and build.
+//   CLANG_FPT_CENSUS_NAMES=1  add type spellings and the named concept; runs
+//                        the TypePrinter inside the deserialization window, so
+//                        off by default.
+//
+// The summary's provisional-est6= counter is the one that matters: a
+// provisional key on an EST_DependentNoexcept type is the only case in which
+// the noexcept expression survives into the canonical type's key.  For
+// EST_NoexceptTrue/False the canonical form is EST_BasicNoexcept/EST_None and
+// the expression is not profiled at all, so a bad key there can only affect a
+// sugar node.
+//===----------------------------------------------------------------------===//
+namespace clang {
+extern unsigned long ClangICSUnpopulatedReadCount;
+} // namespace clang
+
+static unsigned FPTCensusDepth = 0;
+
+namespace {
+struct FPTCensusFrame {
+  FPTCensusFrame() { ++FPTCensusDepth; }
+  ~FPTCensusFrame() { --FPTCensusDepth; }
+};
+
+struct FPTCensusState {
+  unsigned Level;
+  bool Names;
+  bool PrintedTU = false;
+  unsigned NumLookups = 0;
+  unsigned NumBuilt = 0;
+  unsigned NumProvisional = 0;
+  unsigned NumProvisionalByEST[16] = {};
+  unsigned NumProvisionalHits = 0;
+  unsigned NumProvisionalCanonical = 0;
+  unsigned NumCanonicalDups = 0;
+  llvm::StringMap<llvm::SmallVector<const FunctionProtoType *, 2>> Groups;
+
+  FPTCensusState() : Names(::getenv("CLANG_FPT_CENSUS_NAMES") != nullptr) {
+    const char *E = ::getenv("CLANG_FPT_CENSUS");
+    Level = E ? (unsigned)std::strtoul(E, nullptr, 10) : 0;
+    if (E && Level == 0)
+      Level = 1;
+  }
+
+  ~FPTCensusState() {
+    if (!Level)
+      return;
+    llvm::errs() << "[fpt] summary lookups=" << NumLookups
+                 << " built=" << NumBuilt
+                 << " provisional-keys=" << NumProvisional
+                 << " provisional-est6=" << NumProvisionalByEST[6]
+                 << " provisional-est7=" << NumProvisionalByEST[7]
+                 << " provisional-est8=" << NumProvisionalByEST[8]
+                 << " provisional-hits=" << NumProvisionalHits
+                 << " provisional-canonical-nodes=" << NumProvisionalCanonical
+                 << " canonical-dups=" << NumCanonicalDups << '\n';
+  }
+};
+} // namespace
+
+static FPTCensusState &fptCensus() {
+  static FPTCensusState S;
+  return S;
+}
+
+static bool fptCensusEnabled() { return fptCensus().Level != 0; }
+static bool fptCensusVerbose() { return fptCensus().Level >= 2; }
+
+static void fptCensusTU(const ASTContext &Ctx) {
+  FPTCensusState &S = fptCensus();
+  if (S.PrintedTU)
+    return;
+  S.PrintedTU = true;
+  llvm::errs() << "[fpt] tu=";
+  if (auto FE = Ctx.getSourceManager().getFileEntryRefForID(
+          Ctx.getSourceManager().getMainFileID()))
+    llvm::errs() << FE->getName();
+  else
+    llvm::errs() << "<unknown>";
+  llvm::errs() << '\n';
+}
+
+// Shallow identity: everything FunctionProtoType::Profile compares by pointer,
+// minus the deep profile of the noexcept expression. This groups a canonical
+// node together with its sugar nodes on purpose; [fpt-dup] fires only when more
+// than one member of a group is its own canonical form.
+static std::string fptShallowKey(QualType ResultTy, ArrayRef<QualType> ArgArray,
+                                 const FunctionProtoType::ExtProtoInfo &EPI) {
+  std::string Key;
+  llvm::raw_string_ostream OS(Key);
+  OS << ResultTy.getCanonicalType().getAsOpaquePtr();
+  for (QualType A : ArgArray)
+    OS << ',' << A.getCanonicalType().getAsOpaquePtr();
+  OS << '/' << unsigned(EPI.ExceptionSpec.Type) << '/' << EPI.Variadic;
+  return Key;
+}
+
+static void fptCensusNames(QualType ResultTy, ArrayRef<QualType> ArgArray,
+                           const FunctionProtoType::ExtProtoInfo &EPI) {
+  if (!fptCensus().Names)
+    return;
+  llvm::errs() << "\n         ret=" << ResultTy.getAsString();
+  for (QualType A : ArgArray)
+    llvm::errs() << "\n         arg=" << A.getAsString();
+  if (const auto *CSE = dyn_cast_or_null<ConceptSpecializationExpr>(
+          EPI.ExceptionSpec.NoexceptExpr))
+    llvm::errs() << "\n         concept=" << CSE->getNamedConcept()->getName();
+}
+
+static void fptCensusLookup(const ASTContext &Ctx, const FunctionProtoType *Found,
+                            bool Provisional, bool OnlyWantCanonical,
+                            QualType ResultTy, ArrayRef<QualType> ArgArray,
+                            const FunctionProtoType::ExtProtoInfo &EPI) {
+  FPTCensusState &S = fptCensus();
+  ++S.NumLookups;
+  unsigned EST = unsigned(EPI.ExceptionSpec.Type);
+  if (Provisional) {
+    ++S.NumProvisional;
+    if (EST < 16)
+      ++S.NumProvisionalByEST[EST];
+    if (Found)
+      ++S.NumProvisionalHits;
+  }
+
+  if (!fptCensusVerbose() && !Provisional)
+    return;
+  fptCensusTU(Ctx);
+
+  llvm::errs() << "[fpt] depth=" << FPTCensusDepth << " lookup #" << S.NumLookups
+               << (Found ? " HIT" : " MISS")
+               << (Provisional ? " PROVISIONAL-KEY" : "")
+               << (OnlyWantCanonical ? " only-canonical" : "")
+               << " est=" << EST << " nparams=" << ArgArray.size()
+               << " noexcept-expr="
+               << (const void *)EPI.ExceptionSpec.NoexceptExpr;
+  if (Found)
+    llvm::errs() << " found=" << (const void *)Found << " found-noexcept-expr="
+                 << (const void *)Found->getNoexceptExpr();
+  fptCensusNames(ResultTy, ArgArray, EPI);
+  llvm::errs() << '\n';
+
+  if (Found && Provisional)
+    llvm::errs() << "[fpt-bad-hit] a provisional key matched an existing node; "
+                    "this type adopts that node's canonical type\n";
+  if (Provisional && EST == EST_DependentNoexcept)
+    llvm::errs() << "[fpt-bad-dependent] a provisional key was computed for an "
+                    "EST_DependentNoexcept type; the expression is part of its "
+                    "canonical identity\n";
+}
+
+static void fptCensusBuilt(const ASTContext &Ctx, const FunctionProtoType *FTP,
+                           bool Provisional, bool IsCanonicalLocal,
+                           bool CanonicalNull, bool OnlyWantCanonical,
+                           QualType ResultTy, ArrayRef<QualType> ArgArray,
+                           const FunctionProtoType::ExtProtoInfo &EPI) {
+  FPTCensusState &S = fptCensus();
+  ++S.NumBuilt;
+  if (Provisional && CanonicalNull)
+    ++S.NumProvisionalCanonical;
+
+  auto &Group = S.Groups[fptShallowKey(ResultTy, ArgArray, EPI)];
+  Group.push_back(FTP);
+
+  unsigned NumCanonical = 0;
+  for (const FunctionProtoType *P : Group)
+    if (P->isCanonicalUnqualified())
+      ++NumCanonical;
+  bool Dup = NumCanonical > 1;
+  if (Dup)
+    ++S.NumCanonicalDups;
+
+  if (!fptCensusVerbose() && !Provisional && !Dup)
+    return;
+  fptCensusTU(Ctx);
+
+  llvm::errs() << "[fpt] depth=" << FPTCensusDepth << " built #" << S.NumBuilt
+               << " ptr=" << (const void *)FTP
+               << (CanonicalNull ? " canonical" : " sugar")
+               << (Provisional ? " PROVISIONAL-KEY" : "")
+               << (OnlyWantCanonical ? " only-canonical" : "")
+               << " is-canonical=" << IsCanonicalLocal
+               << " canonical-null=" << CanonicalNull
+               << " est=" << unsigned(EPI.ExceptionSpec.Type)
+               << " nparams=" << ArgArray.size() << " noexcept-expr="
+               << (const void *)EPI.ExceptionSpec.NoexceptExpr
+               << " group-size=" << Group.size();
+  fptCensusNames(ResultTy, ArgArray, EPI);
+  llvm::errs() << '\n';
+
+  if (Provisional && CanonicalNull)
+    llvm::errs() << "[fpt-bad-canonical] a canonical node was filed under a "
+                    "provisional key\n";
+  if (Dup) {
+    llvm::errs() << "[fpt-dup] " << NumCanonical
+                 << " canonical types share one shallow key:";
+    for (const FunctionProtoType *P : Group)
+      if (P->isCanonicalUnqualified())
+        llvm::errs() << ' ' << (const void *)P;
+    llvm::errs() << '\n';
+  }
+}
+
 QualType ASTContext::getFunctionTypeInternal(
     QualType ResultTy, ArrayRef<QualType> ArgArray,
     const FunctionProtoType::ExtProtoInfo &EPI, bool OnlyWantCanonical) const {
@@ -5056,16 +5271,28 @@ QualType ASTContext::getFunctionTypeInternal(
 
   // Unique functions, to guarantee there is only one function of a particular
   // structure.
+  // DIAGNOSTIC (not for upstream): depth tracking, and bracket the profile so
+  // we can tell whether this key was computed over an unwritten ICS argument
+  // array.
+  FPTCensusFrame FPTCensusThisFrame;
+  unsigned long FPTCensusReadsBefore = clang::ClangICSUnpopulatedReadCount;
+
   llvm::FoldingSetNodeID ID;
   FunctionProtoType::Profile(ID, ResultTy, ArgArray.begin(), NumArgs, EPI,
                              *this, true);
+  bool FPTCensusProvisional =
+      clang::ClangICSUnpopulatedReadCount != FPTCensusReadsBefore;
 
   QualType Canonical;
   bool Unique = false;
 
   void *InsertPos = nullptr;
-  if (FunctionProtoType *FPT =
-        FunctionProtoTypes.FindNodeOrInsertPos(ID, InsertPos)) {
+  FunctionProtoType *FPTCensusFound =
+      FunctionProtoTypes.FindNodeOrInsertPos(ID, InsertPos);
+  if (fptCensusEnabled() && isComputedNoexcept(EPI.ExceptionSpec.Type))
+    fptCensusLookup(*this, FPTCensusFound, FPTCensusProvisional,
+                    OnlyWantCanonical, ResultTy, ArgArray, EPI);
+  if (FunctionProtoType *FPT = FPTCensusFound) {
     QualType Existing = QualType(FPT, 0);
 
     // If we find a pre-existing equivalent FunctionProtoType, we can just reuse
@@ -5193,6 +5420,10 @@ QualType ASTContext::getFunctionTypeInternal(
     FunctionProtoTypes.InsertNode(FTP, InsertPos);
   if (!EPI.FunctionEffects.empty())
     AnyFunctionEffects = true;
+  if (fptCensusEnabled() && isComputedNoexcept(EPI.ExceptionSpec.Type))
+    fptCensusBuilt(*this, FTP, FPTCensusProvisional, isCanonical,
+                   Canonical.isNull(), OnlyWantCanonical, ResultTy, ArgArray,
+                   EPI);
   return QualType(FTP, 0);
 }
 
diff --git a/lib/AST/DeclTemplate.cpp b/lib/AST/DeclTemplate.cpp
index 290c582..612c931 100644
--- a/lib/AST/DeclTemplate.cpp
+++ b/lib/AST/DeclTemplate.cpp
@@ -1184,7 +1184,19 @@ ICSWindowProbe &icsWindowProbe() {
 }
 } // namespace
 
+namespace clang {
+// DIAGNOSTIC (not for upstream): read by the CLANG_FPT_CENSUS instrumentation
+// in ASTContext.cpp, which brackets FunctionProtoType::Profile with it to tell
+// whether a FoldingSetNodeID was computed over an
+// ImplicitConceptSpecializationDecl whose trailing arguments had not been
+// written yet. Bumped unconditionally so CLANG_FPT_CENSUS works whether or not
+// CLANG_ICS_WINDOW is also enabled.
+unsigned long ClangICSUnpopulatedReadCount = 0;
+} // namespace clang
+
 void ImplicitConceptSpecializationDecl::noteUnpopulatedRead() const {
+  ++clang::ClangICSUnpopulatedReadCount;
+
   ICSWindowProbe &P = icsWindowProbe();
   if (!P.Enabled)
     return;
